# PDC daemon JSON-RPC base URL. Do not append /json_rpc.
# Mainnet RPC port is 19211 (P2P 19121, stratum 19777).
API=http://127.0.0.1:19211

# Explorer HTTP port (Next.js UI and /api are served together).
SERVER_PORT=3000
FRONTEND_API=http://127.0.0.1:3000

# MAIN (default) or TEST. TESTNET daemon ports differ; set API accordingly.
NET_MODE=MAIN

# PostgreSQL. The server creates PGDATABASE when it is missing.
PGUSER=pdc
PGPASSWORD=pdc
PGDATABASE=pdc_explorer
PGHOST=127.0.0.1
PGPORT=5432

# Optional auditable-wallet RPC used only when ENABLE_VISIBILITY_INFO=true.
AUDITABLE_WALLET_API=
ENABLE_VISIBILITY_INFO=false
WEBSOCKET_ENABLED_DURING_SYNC=true
MAX_DAEMON_REQUEST_COUNT=1000

# Optional external services. Leave empty unless you run them for PDC.
ASSETS_WHITELIST_URL=
# Trade API base including /api (oracle USD book, asset prices, Bridge / BTCX peg).
# When empty, falls back to https://api.trade.privacydatacoin.com/api
# Spot PDC/ETH prices use GET {TRADE_API_URL}/prices/usd (source=oracle). Do not use MEXC.
TRADE_API_URL=https://api.trade.privacydatacoin.com/api
MATRIX_API_URL=
NEXT_PUBLIC_MATRIX_HOMESERVER=

# Shown in the header only when set.
NEXT_PUBLIC_MAINNET_EXPLORER=
NEXT_PUBLIC_TESTNET_EXPLORER=
